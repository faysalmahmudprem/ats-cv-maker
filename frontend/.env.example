# Copy this file to `.env.local` and adjust as needed.
# Files starting with .env* are git-ignored — never commit real values.

# Base URL of the FastAPI backend. Leave EMPTY to use the Vite dev proxy
# (recommended for local development — see vite.config.ts and README).
# In production set this to your deployed backend URL, e.g.:
# VITE_API_URL=https://cv-generator-api.onrender.com
VITE_API_URL=

# Public URL of the deployed frontend. Used at build time to fill the
# canonical / og:image tags in index.html (see the site-url plugin in
# vite.config.ts). Optional locally; set it in the Netlify UI for production.
# VITE_SITE_URL=https://your-site.netlify.app
VITE_SITE_URL=
